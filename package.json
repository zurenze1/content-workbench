    "@tesseract.js-data/chi_sim": "1.0.0",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "jsdom": "30.1.2",
    "pdf-parse": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tar-stream": "3.2.2",
    "tesseract.js": "7.0.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
