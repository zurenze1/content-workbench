{
  "name": "content-workbench",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "本地内容创作工作台：真实资料、原件、证据与脚本版本",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server/main.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "restore": "node scripts/restore.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
